+def _reader_url(url):
+    # Jina Reader's documented URL-prefix interface accepts a full public URL after
+    # https://r.jina.ai/. Quote spaces only; keep URL delimiters intact.
+    return 'https://r.jina.ai/'+quote(url, safe=':/?&=%#@+;,')
+
